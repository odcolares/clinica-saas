# Copie para .env (nunca commitar .env — ver .gitignore). Valores abaixo são DUMMY para dev local.
DJANGO_SECRET_KEY=change-me-dev-only-not-for-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://clinica:clinica_dev_only@127.0.0.1:5432/clinica
REDIS_URL=redis://127.0.0.1:6379/0
POSTGRES_DB=clinica
POSTGRES_USER=clinica
POSTGRES_PASSWORD=clinica_dev_only
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
# JWT (segundos; decisão parametrizável — registrar em docs se alterar)
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
# Throttle (req/minuto por escopo; decisão parametrizável)
THROTTLE_LOGIN=10/min
THROTTLE_SIGNUP=5/min
THROTTLE_PASSWORD_RESET=5/min
# Observabilidade (Sentry só ativa com DSN presente; dev pode deixar vazio)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=etapa-0
# Multi-tenancy
TENANT_DEFAULT_DOMAIN=localhost
