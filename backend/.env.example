# Copie para .env (nunca commitar .env — ver .gitignore). Valores abaixo são DUMMY para dev local.
DJANGO_SECRET_KEY=change-me-dev-only-not-for-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://clinica:clinica_dev_only@127.0.0.1:5432/clinica
REDIS_URL=redis://127.0.0.1:6379/0
POSTGRES_DB=clinica
POSTGRES_USER=clinica
POSTGRES_PASSWORD=clinica_dev_only
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
# JWT (segundos; decisão parametrizável — registrar em docs se alterar)
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
# Throttle (req/minuto por escopo; decisão parametrizável)
THROTTLE_LOGIN=10/min
THROTTLE_SIGNUP=5/min
THROTTLE_PASSWORD_RESET=5/min
# Rate limiting por canal (ETAPA 3 — req/min por IP no webhook)
THROTTLE_TELEGRAM=30/min
# Observabilidade (Sentry só ativa com DSN presente; dev pode deixar vazio)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=etapa-0
# Multi-tenancy
TENANT_DEFAULT_DOMAIN=localhost
# Omnichannel / Telegram (ETAPA 3) — segredos reais NUNCA no código
# TELEGRAM_BOT_TOKEN: token do bot (@BotFather); vazio desativa o envio real
# Segredo POR TENANT (recomendado): TELEGRAM_WEBHOOK_SECRET_<SCHEMA>, schema em
#   maiúsculas (ex.: TELEGRAM_WEBHOOK_SECRET_CLINICA_A valida o tenant clinica_a).
#   Valida o header X-Telegram-Bot-Api-Secret-Token; sem segredo do tenant → 403.
# TELEGRAM_WEBHOOK_SECRET: segredo GLOBAL — NÃO usar em produção; só autoriza
#   tenants sem segredo próprio se TELEGRAM_ALLOW_GLOBAL_WEBHOOK_SECRET=True.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOW_GLOBAL_WEBHOOK_SECRET=False
